# --- Rust build artifacts ---
target/
**/*.rs.bk
*.pdb
# Belt-and-braces: compiler outputs, in case a target/ dir is ever nested oddly
*.d
*.o
*.rlib
*.rmeta
*.timestamp
.rustc_info.json

# --- Raw media (huge; kept on disk, never in git) ---
raw_recordings/
*.MP4
*.mp4
*.MOV
*.mov
*.mkv
*.avi

# --- Databases & derived data ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/
# ...except the pokedex reference CSVs (scripts/export-reference.sh)
!pokedex/data/

# --- Importer state ---
.import_ledger.jsonl

# --- Node ---
node_modules/
dist/
npm-debug.log*
yarn-error.log*

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Editors & OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Ingest exporter output (derived; regenerate with pokedex/ingest) ---
pokedex/ingest/out/
*.tsbuildinfo

# Showdown checkouts built by pokedex/ingest/export.sh
pokedex/ingest/.showdown/

# Battle-table dumps from scripts/backup-battles.sh (local, not for git)
backups/

# Scratch area, e.g. transcripts from scripts/transcribe-all.sh
sandbox/
